@model RaceDayMVC.Models.RegisterDto

@{
    ViewData["Title"] = "Register";
}

@Html.Partial("_navigations")

<section class="auth-section">
    <div class="container">

        <div class="auth-card register-card">

            <div class="auth-heading">
                <div class="auth-icon">
                    <i class="bi bi-person-plus-fill"></i>
                </div>

                <span class="section-label">JOIN THE COMMUNITY</span>
                <h2>Create Your <span>Account</span></h2>

                <p>Become part of the RaceDay community.</p>
            </div>

            <form asp-action="Register" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label">
                            First Name
                        </label>

                        <input asp-for="FirstName"
                               class="form-control"
                               placeholder="First name" />

                        <span asp-validation-for="FirstName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">
                            Last Name
                        </label>

                        <input asp-for="LastName"
                               class="form-control"
                               placeholder="Last name" />

                        <span asp-validation-for="LastName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Email" class="form-label">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter your email" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="PhoneNumber" class="form-label">
                            Phone Number
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control"
                               placeholder="Enter phone number" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Role" class="form-label">
                            Account Type
                        </label>

                        <select asp-for="Role"
                                id="accountRole"
                                class="form-select">

                            <option value="">Select account type</option>
                            <option value="Participant">Participant</option>
                            <option value="Organiser">Organiser</option>

                        </select>

                        <span asp-validation-for="Role"
                              class="text-danger"></span>
                    </div>

                    <div id="participantFields" class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="DateOfBirth"
                                   class="form-label">
                                Date of Birth
                            </label>

                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Gender"
                                   class="form-label">
                                Gender
                            </label>

                            <select asp-for="Gender"
                                    class="form-select">

                                <option value="">Select gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                                <option value="Other">
                                    Prefer not to say
                                </option>

                            </select>
                        </div>

                    </div>

                    <div class="col-12">
                        <label asp-for="Password" class="form-label">
                            Password
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Create a password" />

                        <span asp-validation-for="Password"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ConfirmPassword"
                               class="form-label">
                            Confirm Password
                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Confirm your password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <button type="submit"
                                class="btn btn-raceday w-100">
                            Create Account →
                        </button>
                    </div>

                </div>
            </form>

            <div class="auth-footer">
                <p>
                    Already have an account?
                    <a asp-action="Login">Login here</a>
                </p>
            </div>

        </div>
    </div>
</section>


<!-- FOOTER -->
<footer class="raceday-footer">
    <div class="container">

        <div class="row g-4">

            <div class="col-lg-5">

                <h3 class="footer-brand">
                    RACE<span>DAY</span>
                </h3>

                <p>
                    Bringing people together through sports,
                    competitions and unforgettable events.
                </p>

            </div>

            <div class="col-md-4 col-lg-3">

                <h5>Quick Links</h5>

                <ul>
                    <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                    <li><a href="@Url.Action("About", "Home")">About Us</a></li>
                    <li><a href="@Url.Action("Events", "Home")">Previous Events</a></li>
                    <li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
                </ul>

            </div>

            <div class="col-md-8 col-lg-4">

                <h5>Get Started</h5>

                <p>
                    Ready to participate in your next sporting event?
                </p>

                <a href="@Url.Action("Register", "Home")"
                   class="btn btn-raceday">
                    Register Now →
                </a>

            </div>

        </div>

        <hr />

        <div class="footer-bottom">
            <p>
                &copy; @DateTime.Now.Year RaceDay.
                All Rights Reserved.
            </p>
        </div>

    </div>
</footer>


<script>
    const roleSelect = document.getElementById("accountRole");
    const participantFields =
        document.getElementById("participantFields");

    function updateParticipantFields() {
        participantFields.style.display =
            roleSelect.value === "Participant" ? "flex" : "none";
    }

    roleSelect.addEventListener("change", updateParticipantFields);

    updateParticipantFields();
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
