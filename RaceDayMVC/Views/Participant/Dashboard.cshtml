@model RaceDayMVC.Models.ParticipantDashboardModel
@{ViewData["Title"]="Participant dashboard";}<div class="page-heading"><div><h1>Participant dashboard</h1><p>Discover events and manage your race journey.</p></div><a asp-action="BrowseEvents" class="btn btn-primary">Find an event</a></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="summary-card"><h5>My enrolments</h5><strong>@Model.Enrolments.Count</strong></div></div><div class="col-md-4"><div class="summary-card"><h5>Upcoming entries</h5><strong>@Model.Enrolments.Count(e=>e.EventDate>=DateTime.Now)</strong></div></div><div class="col-md-4"><div class="summary-card"><h5>My results</h5><strong>@Model.Results.Count</strong></div></div></div><h2>My upcoming races</h2><div class="list-group mb-4">@foreach(var e in Model.Enrolments.Where(e=>e.EventDate>=DateTime.Now).OrderBy(e=>e.EventDate)){<div class="list-group-item"><h3 class="h5">@e.EventName</h3><p class="mb-0">@e.EventDate.ToString("dd MMM yyyy HH:mm") · @e.CategoryName · @e.Status</p></div>}@if(!Model.Enrolments.Any(e=>e.EventDate>=DateTime.Now)){<p>No upcoming entries yet.</p>}</div><a asp-action="MyEnrolments" class="btn btn-outline-dark">My enrolments</a> <a asp-action="MyResults" class="btn btn-outline-dark">My results</a>