@model RaceDayMVC.Models.CreateEventViewModel
<div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label">Event name</label><input asp-for="Name" class="form-control" required /></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div><div class="mb-3"><label asp-for="EventDate" class="form-label">Event date and time</label><input asp-for="EventDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" required /></div><div class="mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" required /></div><div class="mb-3"><label asp-for="Distance" class="form-label"></label><input asp-for="Distance" class="form-control" required /></div><div class="mb-3"><label asp-for="EventType" class="form-label">Event type</label><select asp-for="EventType" class="form-select"><option>Running</option><option>Cycling</option><option>Walking</option><option>Other</option></select></div>