@model List<RaceDayMVC.Models.EventDto>
@using RaceDayMVC.Services
@inject LocalImageStore Images
@if(!Model.Any()){<div class="empty-panel">No events to show yet.</div>}
<div class="row g-4">@foreach(var ev in Model){var banner=Images.GetPath(ImageKind.Banners,ev.EventId);<div class="col-md-6 col-xl-4"><article class="card event-live h-100">@if(banner!=null){<img src="@Url.Content("~"+banner)" class="event-banner" alt="Banner for @ev.Name" loading="lazy" />}<div class="card-body"><span class="event-label">@ev.EventType · @ev.EventDate.ToString("dd MMM yyyy HH:mm")</span><h3>@ev.Name</h3><p>@ev.Description</p><p><strong>@ev.Location</strong> · @ev.Distance</p><div class="mb-3">@foreach(var c in ev.Categories){<span class="badge category-badge me-1 mb-1">@c.Name · @c.CategoryType</span>}</div>
@if(User.IsInRole("Organiser") && ViewContext.RouteData.Values["controller"]?.ToString()=="Organiser") { <p>@ev.TotalEnrolments entries</p><div class="event-actions"><a asp-action="EditEvent" asp-route-id="@ev.EventId">Edit</a><a asp-action="Banner" asp-route-id="@ev.EventId">Banner</a><a asp-action="Categories" asp-route-id="@ev.EventId">Categories</a><a asp-action="Enrolments" asp-route-id="@ev.EventId">Enrolments</a><a asp-action="Results" asp-route-id="@ev.EventId">Results</a></div><form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" data-confirm="Delete this event? This cannot be undone."><button type="submit" class="btn btn-sm btn-outline-danger mt-3">Delete event</button></form> }
else if(User.IsInRole("Participant")){if(ev.Categories.Any()){<form asp-controller="Participant" asp-action="Enrol" method="post"><input name="eventId" type="hidden" value="@ev.EventId" /><label for="category-@ev.EventId" class="form-label">Choose a category</label><select name="categoryId" id="category-@ev.EventId" class="form-select mb-3">@foreach(var c in ev.Categories){<option value="@c.CategoryId">@c.Name</option>}</select><button class="btn btn-primary" type="submit">Enrol</button></form>}else{<p>No categories available yet.</p>}}
else if(User.Identity?.IsAuthenticated!=true){<a asp-controller="Home" asp-action="Login" class="btn btn-primary">Log in to enrol</a>}
</div></article></div>}</div>