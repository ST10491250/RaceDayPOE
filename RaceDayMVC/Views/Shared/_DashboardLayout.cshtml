@using System.Security.Claims
@using RaceDayMVC.Services
@inject LocalImageStore Images
@{var organiser=User.IsInRole("Organiser"); int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier),out var uid); var photo=Images.GetPath(ImageKind.Profiles,uid);}
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>@ViewData["Title"] - RaceDay</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/features.css" asp-append-version="true" /></head><body>
<nav class="navbar navbar-expand-lg navbar-dark raceday-navbar"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><span class="brand-race">RACE</span><span class="brand-day">DAY</span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#dashboard-nav" aria-controls="dashboard-nav" aria-expanded="false" aria-label="Toggle dashboard navigation"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="dashboard-nav"><div class="navbar-nav ms-auto">
@if(organiser) { <a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a><a class="nav-link" asp-controller="Organiser" asp-action="Events">My events</a><a class="nav-link" asp-controller="Organiser" asp-action="Categories">Categories</a><a class="nav-link" asp-controller="Organiser" asp-action="Enrolments">Enrolments</a><a class="nav-link" asp-controller="Organiser" asp-action="Results">Results</a> }
else { <a class="nav-link" asp-controller="Participant" asp-action="Dashboard">Dashboard</a><a class="nav-link" asp-controller="Participant" asp-action="BrowseEvents">Browse events</a><a class="nav-link" asp-controller="Participant" asp-action="MyEnrolments">My enrolments</a><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a> }
<a class="nav-link" asp-controller="Account" asp-action="Profile">My profile</a><form asp-controller="Home" asp-action="Logout" method="post"><button class="nav-link btn" type="submit">Log out</button></form></div></div></div></nav>
<partial name="_Notices" /><main class="container py-4"><div class="account-strip">@if(photo!=null){<img src="@Url.Content("~"+photo)" class="avatar-small" alt="Your profile photo" />}<span>@User.Identity?.Name · @(organiser ? "Organiser" : "Participant")</span></div>@RenderBody()</main><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/features.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>