<form method="get" class="event-selector mb-4"><label class="form-label" for="selected-event">Select event</label><div class="d-flex gap-2"><select name="id" id="selected-event" class="form-select">@foreach(RaceDayMVC.Models.EventDto ev in ViewBag.Events){if(ev.EventId==(int)ViewBag.EventId){<option value="@ev.EventId" selected>@ev.Name</option>}else{<option value="@ev.EventId">@ev.Name</option>}}</select><button class="btn btn-primary" type="submit">Load</button></div></form>