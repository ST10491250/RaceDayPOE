@{ViewData["Title"]="Request could not be completed";}<section class="container py-5"><h1>We couldn't complete that request.</h1><p>@ViewData["Message"]</p><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a></section>
@if(Context.RequestServices.GetRequiredService<Microsoft.AspNetCore.Hosting.IWebHostEnvironment>().IsDevelopment()) { <div class="container mb-4"><p>Database connection and API startup information:</p><a href="https://localhost:7130/api/health" target="_blank" rel="noopener" class="btn btn-outline-dark">Check API status</a><p class="small mt-3">After applying a fix, stop and restart both projects, then log in again.</p></div> }
