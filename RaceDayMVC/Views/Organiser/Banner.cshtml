@model RaceDayMVC.Models.EventBannerViewModel
@{ViewData["Title"]="Event banner";}<h1>Banner: @Model.EventName</h1><div class="form-panel"><form asp-action="Banner" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="text-danger"></div>@if(Model.BannerPath!=null){<img class="upload-preview mb-3" src="@Url.Content("~"+Model.BannerPath)" alt="Current event banner" />}<div class="upload-panel"><label asp-for="BannerImage" class="form-label">Choose a banner</label><input asp-for="BannerImage" type="file" required class="form-control" accept=".jpg,.jpeg,.png,.webp" data-image-input data-preview-target="banner-preview" /><p class="small mt-2">JPG, PNG or WebP, up to 5 MB.</p><img id="banner-preview" class="upload-preview" alt="Banner preview" hidden /><p class="upload-feedback" aria-live="polite"></p></div><button class="btn btn-primary mt-3" type="submit">Save banner</button></form></div>