@model List<RaceDayMVC.Models.EventDto>
@{ViewData["Title"]="Organiser dashboard";}<div class="page-heading"><div><h1>Organiser dashboard</h1><p>Manage your events, participants and race results.</p></div><a asp-action="CreateEvent" class="btn btn-primary">Create event</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="summary-card"><h5>My events</h5><strong>@Model.Count</strong><p>Events created</p></div></div><div class="col-md-4"><div class="summary-card"><h5>Total enrolments</h5><strong>@Model.Sum(e=>e.TotalEnrolments)</strong><p>Registered entries</p></div></div><div class="col-md-4"><div class="summary-card"><h5>Upcoming events</h5><strong>@Model.Count(e=>e.EventDate>=DateTime.Now)</strong><p>Events coming up</p></div></div></div><h2>Your upcoming events</h2><partial name="_EventCards" model="Model.Where(e=>e.EventDate>=DateTime.Now).OrderBy(e=>e.EventDate).ToList()" /><a asp-action="Events" class="btn btn-outline-dark mt-3">View all events</a>