@model RaceDayMVC.Models.AddCategoryModel
@{ViewData["Title"]="Categories";}<h1>Event categories</h1><partial name="_EventSelector" />@if((int)ViewBag.EventId!=0){<div class="form-panel"><h2>@ViewBag.EventName</h2><form asp-action="Categories" asp-route-id="@ViewBag.EventId" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label">Category name</label><input asp-for="Name" class="form-control" maxlength="100" required /></div><div class="mb-3"><label asp-for="CategoryType" class="form-label">Category type</label><select asp-for="CategoryType" class="form-select"><option>Age</option><option>Distance</option><option>Open</option></select></div><button type="submit" class="btn btn-primary">Add category</button></form><hr /><h3>Existing categories</h3>@foreach(RaceDayMVC.Models.CategoryDto c in ViewBag.Categories){<p>@c.Name · @c.CategoryType</p>}</div>}else{<p>Create an event first.</p>}