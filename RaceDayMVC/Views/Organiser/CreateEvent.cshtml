@model RaceDayMVC.Models.CreateEventViewModel
@{ViewData["Title"]="Create event";}<h1>Create event</h1><div class="form-panel"><form asp-action="CreateEvent" method="post" enctype="multipart/form-data"><partial name="_EventFields" model="Model" /><div class="upload-panel mb-4"><label asp-for="BannerImage" class="form-label">Banner image (optional)</label><input asp-for="BannerImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" data-image-input data-preview-target="banner-preview" /><p class="small mt-2">JPG, PNG or WebP, up to 5 MB.</p><img id="banner-preview" class="upload-preview" alt="Selected banner preview" hidden /><p class="upload-feedback small" aria-live="polite"></p></div><button type="submit" class="btn btn-primary">Create event</button> <a asp-action="Events" class="btn btn-outline-dark">Cancel</a></form></div>