@model List<RaceDayMVC.Models.EnrolmentDto>
@{ViewData["Title"]="Enrolments";}<h1>Participant enrolments</h1><partial name="_EventSelector" /><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Entry</th><th>Participant</th><th>Category</th><th>Status</th><th>Capture result</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>#@e.UniqueId</td><td>@e.ParticipantName</td><td>@e.CategoryName</td><td>@e.Status</td><td>@if(e.Status!="Completed"){<form asp-action="CaptureResult" asp-route-id="@ViewBag.EventId" method="post" class="result-form"><input type="hidden" name="EnrolmentId" value="@e.UniqueId" /><label>Finish time<input name="FinishTime" class="form-control" placeholder="hh:mm:ss" pattern="[0-2][0-9]:[0-5][0-9]:[0-5][0-9]" required /></label><label>Position<input name="FinishingPosition" type="number" min="1" class="form-control" required /></label><button type="submit" class="btn btn-primary">Save</button></form>}else{<span>Result recorded</span>}</td></tr>}</tbody></table>@if(!Model.Any()){<p>No enrolments yet.</p>}</div>